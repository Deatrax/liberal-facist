# Optional locally: without these, an in-memory store is used (single process, lost on restart).
# On Vercel, add the Upstash Redis integration from the Marketplace and these are injected for you.
# Either pair of names works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
